from __future__ import annotations

import configparser
import json
import os
import subprocess
import sys
import time
from pathlib import Path


CONFIG = Path("/etc/macpro-fan.conf")
STATE = Path("/run/macpro-fan/state.json")
HISTORY = Path("/var/lib/macpro-fan/history.json")
SERVICE = "macpro-fan-control.service"


def systemctl(action: str) -> int:
    return subprocess.call(
        ["sudo", "systemctl", action, SERVICE]
    )


def active_state() -> str:
    result = subprocess.run(
        ["systemctl", "is-active", SERVICE],
        capture_output=True,
        text=True,
        check=False,
    )

    return result.stdout.strip() or result.stderr.strip()


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def format_temperature(value: object) -> str:
    if value is None:
        return "n/a"

    try:
        return f"{float(value):.1f}°C"
    except (TypeError, ValueError):
        return "n/a"


def make_bar(
    value: object,
    minimum: float,
    maximum: float,
    width: int = 24,
) -> str:
    try:
        numeric_value = float(value)
    except (TypeError, ValueError):
        return "?" * width

    ratio = (
        (numeric_value - minimum)
        / (maximum - minimum)
    )

    ratio = max(0.0, min(1.0, ratio))
    filled = round(ratio * width)

    return (
        "█" * filled
        + "░" * (width - filled)
    )


def status() -> int:
    data = read_json(STATE)

    print(f"Service:       {active_state()}")

    if not data:
        print("Runtime state is unavailable.")
        return 0

    timestamp = data.get("timestamp", time.time())

    try:
        age = max(
            0,
            int(time.time() - float(timestamp)),
        )
    except (TypeError, ValueError):
        age = 0

    print(
        f"Selected:      "
        f"{data.get('selected_profile', 'n/a')}"
    )
    print(
        f"Active:        "
        f"{data.get('active_profile', 'n/a')}"
    )
    print()

    print(
        f"CPU:           "
        f"{format_temperature(data.get('cpu'))}"
    )

    print(
        f"GPU0:          "
        f"{format_temperature(data.get('gpu0'))}  "
        f"busy={data.get('gpu0_busy', 'n/a')}%"
    )

    print(
        f"GPU1:          "
        f"{format_temperature(data.get('gpu1'))}  "
        f"busy={data.get('gpu1_busy', 'n/a')}%"
    )

    cpu_busy = data.get("cpu_busy")

    if cpu_busy is None:
        print("CPU busy:      n/a")
    else:
        try:
            print(
                f"CPU busy:      "
                f"{float(cpu_busy):.1f}%"
            )
        except (TypeError, ValueError):
            print("CPU busy:      n/a")

    print()

    print(
        f"Control:       "
        f"{format_temperature(data.get('control_temp'))} "
        f"({data.get('control_source', 'n/a')})"
    )

    print(
        f"Fan:           "
        f"{data.get('fan_rpm', 'n/a')} RPM"
    )

    print(
        f"Target:        "
        f"{data.get('target_rpm', 'n/a')} RPM"
    )

    print(
        f"Mode:          "
        f"{data.get('mode', 'n/a')}"
    )

    print(
        f"Polling:       "
        f"{data.get('poll_interval', 'n/a')} seconds"
    )

    print(f"Updated:       {age} seconds ago")

    if data.get("error"):
        print(f"Error:         {data['error']}")

    return 0


def monitor() -> int:
    try:
        while True:
            data = read_json(STATE)

            os.system("clear")

            print("Mac Pro 6,1 Fan Controller")
            print()

            print(f"Service   {active_state()}")

            print(
                f"Profile   "
                f"{data.get('selected_profile', 'n/a')} "
                f"→ "
                f"{data.get('active_profile', 'n/a')}"
            )

            print(
                f"Mode      "
                f"{data.get('mode', 'n/a')}"
            )

            print()

            cpu = data.get("cpu")
            gpu0 = data.get("gpu0")
            gpu1 = data.get("gpu1")
            fan = data.get("fan_rpm")
            target = data.get("target_rpm")
            cpu_busy = data.get("cpu_busy")

            print(
                f"CPU   "
                f"{make_bar(cpu, 35, 90)} "
                f"{format_temperature(cpu)}"
            )

            print(
                f"GPU0  "
                f"{make_bar(gpu0, 35, 90)} "
                f"{format_temperature(gpu0)}  "
                f"busy={data.get('gpu0_busy', 'n/a')}%"
            )

            print(
                f"GPU1  "
                f"{make_bar(gpu1, 35, 90)} "
                f"{format_temperature(gpu1)}  "
                f"busy={data.get('gpu1_busy', 'n/a')}%"
            )

            cpu_busy_text = "n/a"

            if cpu_busy is not None:
                try:
                    cpu_busy_text = (
                        f"{float(cpu_busy):.1f}%"
                    )
                except (TypeError, ValueError):
                    pass

            print(
                f"Load  "
                f"{make_bar(cpu_busy, 0, 100)} "
                f"{cpu_busy_text}"
            )

            print(
                f"Fan   "
                f"{make_bar(fan, 790, 1900)} "
                f"{fan if fan is not None else 'n/a'} RPM"
            )

            print(
                f"Goal  "
                f"{make_bar(target, 790, 1900)} "
                f"{target if target is not None else 'n/a'} RPM"
            )

            print()
            print("Ctrl+C to exit")

            time.sleep(1)

    except KeyboardInterrupt:
        return 0


def history() -> int:
    data = read_json(HISTORY)

    if not data:
        print("No history is available yet.")
        return 0

    samples = max(
        1,
        int(data.get("samples", 0)),
    )

    average_fan = int(
        data.get("fan_sum", 0)
        / samples
    )

    uptime = int(
        time.time()
        - data.get("started", time.time())
    )

    print(
        f"Tracked time:       "
        f"{uptime // 3600}h "
        f"{(uptime % 3600) // 60}m"
    )

    print(f"Samples:            {samples}")

    print(
        f"CPU peak:           "
        f"{data.get('cpu_peak', 0):.1f}°C"
    )

    print(
        f"GPU0 peak:          "
        f"{data.get('gpu0_peak', 0):.1f}°C"
    )

    print(
        f"GPU1 peak:          "
        f"{data.get('gpu1_peak', 0):.1f}°C"
    )

    print(
        f"Average fan:        "
        f"{average_fan} RPM"
    )

    print(
        f"Maximum fan:        "
        f"{data.get('fan_peak', 0)} RPM"
    )

    print(
        f"Emergency events:   "
        f"{data.get('emergency_events', 0)}"
    )

    return 0


def reset_history() -> int:
    return subprocess.call(
        ["sudo", "rm", "-f", str(HISTORY)]
    )


def test_controller() -> int:
    return subprocess.call(
        [
            "sudo",
            "/usr/local/sbin/macpro-fan-control.py",
            "--check",
        ]
    )


def set_profile(requested: str) -> int:
    cfg = configparser.ConfigParser()

    if not cfg.read(CONFIG):
        print(
            f"Cannot read {CONFIG}",
            file=sys.stderr,
        )
        return 1

    available = ["Auto"]

    available.extend(
        section.split(":", 1)[1]
        for section in cfg.sections()
        if section.startswith("Profile:")
    )

    match = next(
        (
            profile
            for profile in available
            if profile.lower() == requested.lower()
        ),
        None,
    )

    if match is None:
        print(
            "Available profiles: "
            + ", ".join(available),
            file=sys.stderr,
        )
        return 1

    if "General" not in cfg:
        cfg.add_section("General")

    cfg["General"]["Profile"] = match

    temporary = CONFIG.with_suffix(".tmp")

    try:
        with temporary.open("w") as handle:
            cfg.write(handle)

        os.replace(temporary, CONFIG)

    except PermissionError:
        print(
            "Permission denied. Run the profile "
            "command through sudo, for example:",
            file=sys.stderr,
        )
        print(
            f"sudo macpro-fan profile {match}",
            file=sys.stderr,
        )
        return 1

    print(f"Selected profile: {match}")
    print(
        "The running service will reload "
        "the configuration automatically."
    )

    return 0


def usage() -> None:
    print(
        "Usage: macpro-fan "
        "{status|monitor|history|reset-history|"
        "test|start|stop|restart|profile PROFILE}"
    )


def main() -> int:
    if len(sys.argv) < 2:
        usage()
        return 1

    command = sys.argv[1].lower()

    if command == "status":
        return status()

    if command == "monitor":
        return monitor()

    if command == "history":
        return history()

    if command == "reset-history":
        return reset_history()

    if command == "test":
        return test_controller()

    if command in {"start", "stop", "restart"}:
        return systemctl(command)

    if command == "profile" and len(sys.argv) == 3:
        return set_profile(sys.argv[2])

    usage()
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
